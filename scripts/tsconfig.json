{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "../types/index.d.ts"],
    "paths": {
      "@types": ["../types/index.d.ts"],
      "@appSrc/*": ["../app/*"],
      "@commonSrc/*": ["../common/*"],
      "@utilitiesSrc/*": ["../UtilitiesForPC/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../common/**/*",
    "../types/**/*.d.ts",
    "../app/app.config.ts"
  ],
  "exclude": ["node_modules", "tests"]
}
