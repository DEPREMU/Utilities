{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "lib": ["esnext"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "skipLibCheck": true,
    "paths": {
      "@types": ["./index.d.ts"],
      "@common": ["../common/both"]
    }
  },
  "include": ["./**/*.d.ts"],
  "exclude": []
}
