{
  "name": "utilities-for-pc",
  "version": "1.0.0",
  "description": "A collection of useful utilities for PC users.",
  "main": "build/index.cjs",
  "scripts": {
    "build": "node createApp/build.ts",
    "start": "npm run build-app export-web && npm run build && npx electron . --expose-gc",
    "start:debug": "npm run build-app export-web && npm run build && npx electron . --expose-gc --inspect=5858",
    "pack": "npm run build && npx electron-builder",
    "build-app": "node createApp/createApp.ts",
    "type-check": "tsc --project src/tsconfig.json --noEmit",
    "dist": "npm run build && npx electron-builder --publish=never"
  },
  "homepage": "https://example.com",
  "author": {
    "name": "DEPREMU",
    "email": "email@example.com"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dnssd": "^0.4.1",
    "electron-store": "^11.0.2",
    "express": "^5.1.0",
    "keytar": "^7.9.0",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "@espcom/esbuild-plugin-replace": "^1.3.2",
    "@types/chalk": "^0.4.31",
    "@types/cors": "^2.8.19",
    "@types/dnssd": "^0.4.5",
    "@types/express": "^5.0.5",
    "@types/keytar": "^4.4.0",
    "electron": "^39.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2"
  },
  "build": {
    "appId": "com.utilities.depremu",
    "productName": "UtilitiesForPC",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build/preload.cjs",
        "to": "resources/preload.cjs"
      }
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "dist/assets/fonts",
        "to": "assets/fonts"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/tray-icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
