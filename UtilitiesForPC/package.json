{
  "name": "utilities-for-pc",
  "version": "1.1.1",
  "description": "A collection of useful utilities for PC users.",
  "main": "build/index.cjs",
  "scripts": {
    "type-check": "tsc --project src/tsconfig.json --noEmit",
    "before-commit": "npm run type-check"
  },
  "homepage": "https://example.com",
  "author": {
    "name": "DEPREMU",
    "email": "email@example.com"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "cors": "^2.8.5",
    "dnssd": "^0.4.1",
    "electron-store": "^11.0.2",
    "express": "^5.2.1",
    "node-machine-id": "^1.1.12",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/axios": "^0.14.4",
    "@types/chalk": "^2.2.4",
    "@types/cors": "^2.8.19",
    "@types/dnssd": "^0.4.5",
    "@types/express": "^5.0.6",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.utilities.depremu",
    "productName": "UtilitiesForPC",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "build/preload.cjs",
        "to": "resources/preload.cjs"
      }
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "dist/assets/fonts",
        "to": "assets/fonts"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/tray-icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "linux": {
      "target": "deb",
      "icon": "assets/tray-icon.png",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
