{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": false,
    "typeRoots": ["../node_modules/@types", "../../types/index.d.ts"],
    "paths": {
      "@utils": ["./main/utils"],
      "@types": ["../../types/index.d.ts"],
      "@common": ["../../common/serverOrElectron/index.ts"]
    }
  },
  "include": ["./**/*.ts", "../../common/index.ts"],
  "exclude": ["node_modules", "build", "dist", "release"]
}
