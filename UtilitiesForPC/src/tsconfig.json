{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": false,
    "typeRoots": ["../node_modules/@types", "../../types/index.d.ts"],
    "paths": {
      "@utils": ["./main/utils"],
      "@types": ["../../types/index.d.ts"]
    }
  },

  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "build", "dist", "release"]
}
