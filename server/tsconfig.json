{
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@types": ["../types/index.d.ts"],
      "@common": ["../common/serverOrElectron/index.ts"]
    },
    "typeRoots": ["../types/index.d.ts"]
  },
  "include": ["./**/*.ts", "../common/index.ts"],
  "exclude": [
    "node_modules",
    "config-oracle",
    "eslint.config.ts",
    "build/index.cjs"
  ]
}
