{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@types": ["../types/index.d.ts"],
      "@common": ["../common/serverOrElectron/index.ts"]
    },
    "typeRoots": ["../types/index.d.ts"]
  },
  "include": ["./**/*.ts", "../common/index.ts"],
  "exclude": [
    "config-vps",
    "node_modules",
    "build/index.cjs",
    "eslint.config.ts"
  ]
}
