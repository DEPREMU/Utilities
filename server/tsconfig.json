{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    "esModuleInterop": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "@types": ["../types/index.d.ts"],
      "@common": ["../common/serverOrElectron/index.ts"],
      "@commonSrc/*": ["../common/*"]
    },
    "typeRoots": ["../types/index.d.ts", "./generated/*.d.ts"]
  },
  "include": ["./**/*.ts", "../common/**/*"],
  "exclude": [
    "config-vps",
    "tests/**/*",
    "node_modules",
    "build/index.cjs",
    "eslint.config.ts"
  ]
}
