{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node ./build.ts && node ./build/index.cjs",
    "start-dev": "yarn nodemon -i cryptos.json -e ts,json --exec \"sleep 5; node ./build.ts; node ./build/index.cjs\"",
    "format-all": "yarn prettier --write \"**/*.{ts,json}\" --ignore-path ../.gitignore",
    "before-commit": "yarn run lint:fix && yarn run type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "crypto": "^1.0.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.6.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pidusage": "^4.0.1",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.11.10",
    "@types/pidusage": "^2.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10"
  }
}
