{
  "name": "utilities-server",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "db-update": "yarn run db-migrate:dev && prisma generate",
    "db-migrate:dev": "prisma migrate dev",
    "db-migrate:prod": "prisma migrate deploy",
    "db-generate": "prisma generate",
    "sleep": "run-script-os",
    "sleep:windows": "powershell -Command \"Start-Sleep -Seconds 5\"",
    "sleep:linux": "sleep 5",
    "start": "tsx ./build.ts && node ./build/index.cjs",
    "start-dev": "docker-compose -f vps/docker/docker-compose.dev.yml up -d && yarn nodemon",
    "format-all": "yarn prettier --write \"**/*.{ts,json}\" --ignore-path ../.gitignore",
    "before-commit": "yarn run lint:fix && yarn run type-check",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "test": "jest --runInBand"
  },
  "author": "DEPREMU",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@node-rs/bcrypt": "^1.10.9",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "bullmq": "^6.3.11",
    "busboy": "^1.6.0",
    "compression": "^1.8.2", 
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.14",
    "pidusage": "^4.0.1",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pidusage": "^2.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "ioredis-mock": "^8.13.1",
    "prisma": "^7.10.0"
  }
}
