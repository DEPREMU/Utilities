{
  "name": "utilities",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "private": true,
  "workspaces": [
    "app",
    "types",
    "common",
    "server",
    "scripts",
    "frontend",
    "UtilitiesForPC",
    "packages/*"
  ],
  "scripts": {
    "__ROOT__": "______________________________________________",
    "clean": "node scripts/run.ts clean",
    "clean:all": "node scripts/run.ts clean:all",
    "format-all": "node scripts/run.ts format-all",
    "app": "node scripts/run.ts app",
    "server": "yarn --cwd server run start",
    "server-dev": "yarn --cwd server run start-dev",
    "type-check": "node scripts/run.ts type-check",
    "before-commit": "yarn workspaces run before-commit",
    "before-commit:testing": "yarn run before-commit && yarn run tests",
    "build-web": "node scripts/run.ts build-web",
    "app-compile-check": "node scripts/run.ts app-compile-check",
    "__APP__": "_______________________________________________",
    "app-prebuild-android": "node scripts/run.ts app-prebuild-android",
    "app-build-dev-android": "node scripts/run.ts app-build-dev-android",
    "expo-check": "cross-env BUILD_PROFILE=development yarn workspace utilities-app expo install --check",
    "__UTILITIES_FOR_PC__": "__________________________________",
    "build-app-electron": "node scripts/run.ts build-app-electron",
    "build-web-app-electron": "node scripts/run.ts build-web-app-electron",
    "build-resources-electron": "node scripts/run.ts build-resources-electron",
    "start-electron": "node scripts/run.ts start-electron",
    "__SCRIPTS__": "___________________________________________",
    "scripts-test": "yarn workspace utilities-scripts run test",
    "update-assets": "node scripts/run.ts update-assets",
    "build-android": "node scripts/run.ts build-android",
    "build-upload-electron": "node scripts/run.ts build-upload-electron",
    "build-upload-android": "node scripts/run.ts build-upload-android",
    "build-autocomplete-dict": "node scripts/run.ts build-autocomplete-dict",
    "__COMMON__": "___________________________________________",
    "common-test": "yarn workspace utilities-common run test",
    "__FRONTEND__": "___________________________________________",
    "dev-frontend": "node scripts/run.ts dev-frontend",
    "dev-clipboard-frontend": "node scripts/run.ts dev-clipboard-frontend",
    "build-frontend": "node scripts/run.ts build-frontend",
    "build-clipboard-frontend": "node scripts/run.ts build-clipboard-frontend",
    "__SERVER__": "___________________________________________",
    "server-test": "yarn workspace utilities-server run test",
    "test-vps": "docker compose -f server/vps/docker/docker-compose.test.yml up",
    "test-vps:bg": "docker compose -f server/vps/docker/docker-compose.test.yml up -d",
    "open-vps": "yarn run test-vps:bg && yarn workspace utilities-server run sleep && docker compose -f server/vps/docker/docker-compose.test.yml exec server bash",
    "delete-vps": "docker compose -f server/vps/docker/docker-compose.test.yml down -v",
    "build-vps": "docker build -f server/vps/docker/Dockerfile -t utilities-server .",
    "tag-vps": "docker tag utilities-server:latest depremu/utilities-server:latest",
    "push-vps": "docker push depremu/utilities-server:latest",
    "update-vps": "yarn run build-vps && yarn run tag-vps && yarn run push-vps",
    "__TESTS__": "___________________________________________",
    "tests": "yarn workspaces run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEPREMU/Utilities.git"
  },
  "author": "DEPREMU",
  "dependencies": {
    "@types/cli-progress": "^3.11.6",
    "axios": "^1.19.0",
    "bytes": "^3.1.2",
    "chalk": "^6.0.0",
    "cli-progress": "^3.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "humanize-duration": "^3.34.0",
    "lodash": "^4.18.1",
    "lucide": "^1.33.0",
    "morphicons": "^1.7.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "piscina": "^5.3.0",
    "sharp": "^0.35.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@espcom/esbuild-plugin-replace": "^1.3.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/archiver": "^8.0.0",
    "@types/bytes": "^3.1.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/humanize-duration": "^3.27.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.0.1",
    "@types/node-7z": "^2.1.11",
    "@types/pdfkit": "^0.17.6",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "run-script-os": "^1.1.6",
    "tsc": "^2.0.4",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
