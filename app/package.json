{
  "name": "utilities",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "npx expo start -c -g --lan",
    "clean": "npx rimraf .expo node_modules package-lock.json && npm cache clean --force",
    "clean:all": "npm run clean && npm run install-all",
    "app": "npx expo start -c -g",
    "app-dev": "npx expo start -c -d",
    "build:android": "eas build --clear-cache --platform android --profile preview && npm run install-all",
    "build-dev:android": "eas build --clear-cache --platform android --profile development && npm run install-all",
    "build:web": "npx expo export --platform web",
    "install-all": "npm install & cd server & npm install",
    "prebuild": "node ../app/native/createPrebuild.ts",
    "format-all": "npx prettier --write \"**/*.{ts,tsx}\" --ignore-path ../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "android": "npx expo run:android",
    "build-with-prebuild": "cmd /c \"if not exist android npm run prebuild\" && cd android && gradlew.bat assembleRelease",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.12.1",
    "core-js": "^3.45.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.2",
    "expo": "54.0.8",
    "expo-background-fetch": "~14.0.7",
    "expo-blur": "~15.0.7",
    "expo-build-properties": "~1.0.8",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.8",
    "expo-dev-client": "~6.0.12",
    "expo-device": "~8.0.7",
    "expo-font": "~14.0.8",
    "expo-gl": "~16.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-localization": "~17.0.7",
    "expo-network": "~8.0.7",
    "expo-notifications": "~0.32.11",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-task-manager": "~14.0.7",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lodash": "^4.17.21",
    "memoize-one": "^6.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.81.4",
    "react-native-device-info": "^14.0.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "^0.21.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.1.13",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-doctor": "^1.17.7",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
