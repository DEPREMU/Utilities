{
  "name": "utilities",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "npx expo start -c -g --lan",
    "clean": "npx rimraf .expo node_modules package-lock.json && npm cache clean --force",
    "clean:all": "npm run clean && npm run install-all",
    "app": "npx expo start -c -g",
    "app-dev": "npx expo start -c -d",
    "build:android": "eas build --clear-cache --platform android --profile preview && npm run install-all",
    "build-dev:android": "eas build --clear-cache --platform android --profile development && npm run install-all",
    "build:web": "npx expo export --platform web",
    "install-all": "npm install & cd server & npm install",
    "prebuild": "node ../app/native/createPrebuild.ts",
    "format-all": "npx prettier --write \"**/*.{ts,tsx}\" --ignore-path ../.gitignore",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "type-check": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.13",
    "@react-navigation/stack": "^7.4.5",
    "@supabase/supabase-js": "^2.51.0",
    "axios": "^1.9.0",
    "core-js": "^3.44.0",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.1",
    "expo": "53.0.22",
    "expo-background-fetch": "~13.1.5",
    "expo-build-properties": "^0.14.8",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-linear-gradient": "~14.1.5",
    "expo-localization": "~16.1.6",
    "expo-network": "~7.1.5",
    "expo-notifications": "^0.31.4",
    "expo-secure-store": "~14.2.4",
    "expo-skeleton-loading": "*",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.6",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "memoize-one": "^6.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-i18next": "^15.6.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-paper": "^5.14.3",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-skeleton-loading": "^1.1.1",
    "react-native-web": "^0.20.0",
    "expo-clipboard": "~7.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-doctor": "^1.17.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3"
  },
  "private": true
}
