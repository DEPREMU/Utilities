{
  "extends": "expo/tsconfig.base",
  "typeRoutes": ["../types/index.d.ts"],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/types/*",
    "../common/both/index.ts",
    "../common/both/notifications.ts"
  ],
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["src/*"],
      "@refs": ["src/app/refs/"],
      "@utils": ["src/utils/"],
      "@types": ["../types/index.d.ts"],
      "@common": ["../common/both/"],
      "@modules": ["src/utils/modules/"],
      "@hooks/*": ["src/hooks/*"],
      "@assets/*": ["src/assets/*"],
      "@screens/*": ["src/features/*"],
      "@context/*": ["src/context/*"],
      "@components/*": ["src/components/*"],
      "@navigation/*": ["src/app/navigation/*"]
    }
  }
}
