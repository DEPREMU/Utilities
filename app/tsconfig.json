{
  "extends": "expo/tsconfig.base",
  "typeRoutes": ["../types/index.d.ts"],
  "include": ["**/*.ts", "**/*.tsx", "**/types/*", "../common/both/index.ts"],
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@refs": ["./src/app/refs/"],
      "@utils": ["./src/utils/"],
      "@types": ["../types/index.d.ts"],
      "@common": ["../common/both/"],
      "@modules": ["./src/utils/modules/"],
      "@hooks/*": ["./src/hooks/*"],
      "@assets/*": ["./src/assets/*"],
      "@screens/*": ["./src/features/*"],
      "@context/*": ["./src/context/*"],
      "@navigation/*": ["./src/app/navigation/*"],
      "@components/*": ["./src/common/components/*"]
    }
  }
}
