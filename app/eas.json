{
  "cli": {
    "version": ">= 16.19.3",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "WS_URL": "$WS_URL",
        "API_URL": "$API_URL",
        "ADMIN_PASSWORD": "$ADMIN_PASSWORD",
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "env": {
        "WS_URL": "$WS_URL",
        "API_URL": "$API_URL",
        "ADMIN_PASSWORD": "$ADMIN_PASSWORD",
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      }
    },
    "production": {
      "env": {
        "WS_URL": "$WS_URL",
        "API_URL": "$API_URL",
        "ADMIN_PASSWORD": "$ADMIN_PASSWORD",
        "GOOGLE_SERVICES_JSON": "$GOOGLE_SERVICES_JSON"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
