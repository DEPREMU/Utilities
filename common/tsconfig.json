{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@commonSrc/*": ["./*"],
      "@types": ["../types/index.d.ts"],
      "@REPLACERS": ["./both/REPLACERS/REPLACERS"]
    }
